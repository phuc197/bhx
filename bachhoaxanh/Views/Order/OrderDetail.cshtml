@model bachhoaxanh.Models.Order
@{
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID;
    var details = ViewBag.OrderDetails as List<bachhoaxanh.Models.OrderDetail>;
    long amountInt = Convert.ToInt64(Model.TotalAmount);
    string transferMemo = "BHX" + Model.OrderID;
    string qrSrc = "https://img." + "vietqr.io/image/MB-1972482006-qr_only.png?amount=" + amountInt + "&addInfo=" + transferMemo + "&accountName=NGUYEN%20HOANG%20PHUC";
}

<div class="container my-4" style="max-width: 720px;">
    <!-- 1. KHUNG THÔNG BÁO ĐẶT HÀNG THÀNH CÔNG -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
        <div class="text-center mb-3">
            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px; font-size: 24px;">
                &#10004;
            </div>
            <h5 class="fw-bold text-success m-0">ĐẶT HÀNG THÀNH CÔNG</h5>
            <small class="text-muted">Mã đơn hàng: #@Model.OrderID</small>
        </div>

        <div class="border-top pt-3">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Trạng thái thanh toán:</span>
                <span id="orderStatusBadge" class="fw-bold @(Model.Status == "Đã thanh toán" ? "text-success" : "text-warning")">
                    @Model.Status
                </span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Tổng thanh toán:</span>
                <strong class="text-danger fs-5">@String.Format("{0:0,0}", Model.TotalAmount)đ</strong>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Địa chỉ giao hàng:</span>
                <span class="fw-semibold text-end" style="max-width: 65%;">@Model.ShippingAddress</span>
            </div>
        </div>
    </div>

    <!-- 2. KHUNG QUÉT MÃ VIETQR TỰ ĐỘNG THEO SỐ TIỀN ĐƠN HÀNG & ĐẾM NGƯỢC 10 PHÚT -->
    @if (Model.Status == "Chờ thanh toán QR")
    {
        <div id="qrPaymentSection" class="card border-0 shadow-sm rounded-4 p-4 mb-3 text-center">
            <div class="mb-3 fs-6">
                Chuyển khoản trước cho đơn này trong
                <span id="timer10Min" class="badge bg-warning text-dark fs-6 px-2 py-1">10:00</span>
            </div>

            <div class="border rounded-4 p-3 bg-white shadow-sm d-inline-block mx-auto mb-3" style="max-width: 300px; width: 100%;">
                <div class="fw-bold mb-2" style="letter-spacing: 1px;">
                    <span class="text-danger">VIET</span><span class="text-primary">QR</span> <span class="badge bg-success">PRO</span>
                </div>

                <div class="d-flex justify-content-center align-items-center my-2">
                    <img src="@qrSrc" alt="Mã QR MB Bank" style="width: 220px; height: 220px; object-fit: contain;" />
                </div>

                <div class="border-top pt-2 mt-2 small">
                    <div class="fw-bold text-primary">MB Bank - 1972482006</div>
                    <div class="fw-bold text-dark">NGUYEN HOANG PHUC</div>
                    <div class="text-danger fw-bold fs-6 mt-1">@String.Format("{0:0,0}", Model.TotalAmount)đ</div>
                </div>
            </div>

            <div class="small text-muted mb-3">
                Nội dung chuyển khoản bắt buộc: <span class="badge bg-light text-danger border fs-6">@transferMemo</span>
            </div>

            <div class="alert alert-info py-2 small m-0">
                Hệ thống đang chờ ngân hàng xác nhận giao dịch <strong>@transferMemo</strong>...
            </div>
        </div>
    }

    <!-- 3. CHI TIẾT CÁC MÓN ĐÃ ĐẶT -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
        <h6 class="fw-bold border-bottom pb-2 mb-3">Sản phẩm đã đặt</h6>
        @if (details != null)
        {
            foreach (var item in details)
            {
                <div class="d-flex justify-content-between align-items-center mb-2 small">
                    <div>
                        <span class="fw-bold">@(item.Product != null ? item.Product.ProductName : "Sản phẩm")</span>
                        <span class="text-muted"> (x @item.Quantity)</span>
                    </div>
                    <span class="fw-bold">@String.Format("{0:0,0}", item.Price * item.Quantity)đ</span>
                </div>
            }
        }
    </div>

    <div class="text-center">
        <a href="/Order/History" class="btn btn-outline-success fw-bold px-4 me-2">Xem lịch sử đơn hàng</a>
        <a href="/" class="btn btn-success fw-bold px-4">Tiếp tục mua sắm</a>
    </div>
</div>

@if (Model.Status == "Chờ thanh toán QR")
{
    <script>
        var totalSeconds = 600;
        var timerEl = document.getElementById('timer10Min');
        var qrSection = document.getElementById('qrPaymentSection');
        var statusBadge = document.getElementById('orderStatusBadge');
        var orderId = "@Model.OrderID";
        var pollInterval = 0;

        var countdownInterval = setInterval(function () {
            totalSeconds--;
            if (totalSeconds < 0) {
                clearInterval(countdownInterval);
                clearInterval(pollInterval);
                if (qrSection) {
                    qrSection.innerHTML = '<div class="alert alert-danger fw-bold m-0">Đã hết thời gian 10 phút thanh toán QR cho đơn hàng này!</div>';
                }
                return;
            }

            var mins = Math.floor(totalSeconds / 60);
            var secs = totalSeconds % 60;
            var formatted = (mins < 10 ? "0" : "") + mins + ":" + (secs < 10 ? "0" : "") + secs;
            if (timerEl) timerEl.textContent = formatted;
        }, 1000);

        pollInterval = setInterval(function () {
            fetch('/Order/CheckPaymentStatus?id=' + orderId)
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data && data.paid === true) {
                        clearInterval(countdownInterval);
                        clearInterval(pollInterval);
                        if (statusBadge) {
                            statusBadge.className = "fw-bold text-success";
                            statusBadge.textContent = "Đã thanh toán";
                        }
                        if (qrSection) {
                            qrSection.innerHTML = '<div class="alert alert-success fw-bold py-3 m-0 fs-6">&#10004; ĐÃ NHẬN ĐƯỢC TIỀN CHUYỂN KHOẢN THÀNH CÔNG!</div>';
                        }
                    }
                });
        }, 3000);
    </script>
}
