@model List<bachhoaxanh.Models.CartItem>
@{
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
    ViewBag.Title = "Xác nhận thanh toán";
    var user = ViewBag.UserInfo as bachhoaxanh.Models.User;
}

<div class="container my-5">
    <h3 class="fw-bold text-success mb-4 border-bottom pb-2">
        <i class="fa-solid fa-credit-card me-2"></i>XÁC NHẬN ĐƠN HÀNG & THANH TOÁN
    </h3>

    <div class="row g-4">
        <!-- Cột trái: Form thông tin giao nhận (Tự động điền từ tài khoản) -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <h5 class="fw-bold text-dark mb-3">Thông tin người nhận hàng</h5>
                <form action="/Order/Checkout" method="POST">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên người nhận</label>
                        <input type="text" class="form-control bg-light" value="@(user != null ? user.FullName : "")" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại liên hệ</label>
                        <input type="text" class="form-control bg-light" value="@(user != null ? user.Phone : "")" readonly />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Địa chỉ giao hàng thực tế <span class="text-danger">*</span></label>
                        <textarea name="shippingAddress" class="form-control" rows="3" required>@(user != null ? user.Address : "")</textarea>
                        <small class="text-muted">Bạn có thể chỉnh sửa địa chỉ nhận hàng nếu muốn giao đến nơi khác.</small>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 fw-bold shadow-sm">
                        <i class="fa-solid fa-check-circle me-2"></i>XÁC NHẬN ĐẶT HÀNG
                    </button>
                </form>
            </div>
        </div>

        <!-- Cột phải: Tóm tắt các món hàng trong giỏ -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4 bg-light">
                <h5 class="fw-bold text-dark mb-3">Danh sách sản phẩm (@Model.Sum(c => c.Quantity) món)</h5>
                <ul class="list-group mb-3">
                    @foreach (var item in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="my-0 fw-bold">@item.ProductName</h6>
                                <small class="text-muted">Số lượng: @item.Quantity @item.Unit x @String.Format("{0:0,0}", item.Price) đ</small>
                            </div>
                            <span class="text-danger fw-bold">@String.Format("{0:0,0}", item.TotalPrice) đ</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between bg-white">
                        <span class="fw-bold fs-5">Tổng thanh toán:</span>
                        <strong class="text-danger fs-5">@String.Format("{0:0,0}", ViewBag.TotalAmount) đ</strong>
                    </li>
                </ul>
                <a href="/Cart" class="btn btn-outline-secondary btn-sm">Quay lại chỉnh sửa giỏ hàng</a>
            </div>
        </div>
    </div>
</div>
