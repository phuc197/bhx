@model IEnumerable<bachhoaxanh.Models.CartItem>
@{
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
    ViewBag.Title = "Xác nhận đơn hàng & Thanh toán";
    decimal totalAmount = Model != null ? Model.Sum(item => item.TotalPrice) : 0;
}

<div class="container my-4">
    <h4 class="fw-bold text-success mb-4 text-uppercase">XÁC NHẬN ĐƠN HÀNG & THANH TOÁN</h4>

    <form id="checkoutForm" action="/Order/Checkout" method="POST">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- CỘT TRÁI: THÔNG TIN NHẬN HÀNG & PHƯƠNG THỨC THANH TOÁN -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3">Thông tin người nhận hàng</h5>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Họ và tên người nhận</label>
                        <input type="text" name="FullName" class="form-control bg-light" value="@Session["UserFullName"]" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                        <input type="tel" name="Phone" id="PhoneInput" class="form-control"
                               value="@ViewBag.UserPhone"
                               maxlength="10"
                               pattern="^0[1-9][0-9]{8}$"
                               placeholder="Nhập số điện thoại nhận hàng (10 số)..." required />
                    </div>

                    <!-- Ô ĐỊA CHỈ GIAO HÀNG CÓ NÚT MỞ POPUP CHỌN GIỐNG BÁCH HÓA XANH -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold small m-0">Địa chỉ giao hàng thực tế <span class="text-danger">*</span></label>
                            <button type="button" id="btnOpenAddrModal" class="btn btn-sm btn-outline-success fw-bold">
                                Chọn địa chỉ / Lấy vị trí hiện tại
                            </button>
                        </div>
                        <textarea name="ShippingAddress" id="ShippingAddress" class="form-control" rows="2" required placeholder="Vui lòng chọn khu vực và nhập số nhà, tên đường...">@ViewBag.UserAddress</textarea>
                        <small class="text-muted">Bạn có thể bấm nút bên trên để định vị nhanh hoặc tự nhập số nhà, tên đường.</small>
                    </div>
                </div>

                <!-- PHƯƠNG THỨC THANH TOÁN (COD HOẶC QUÉT MÃ QR Ở TRANG KẾ TIẾP) -->
                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-3">Phương thức thanh toán</h5>

                    <div class="form-check border rounded p-3 mb-2">
                        <input class="form-check-input ms-1 me-2" type="radio" name="paymentMethod" id="payCOD" value="COD" checked />
                        <label class="form-check-label fw-bold" for="payCOD">
                            Thanh toán tiền mặt khi nhận hàng (COD)
                        </label>
                    </div>

                    <div class="form-check border rounded p-3">
                        <input class="form-check-input ms-1 me-2" type="radio" name="paymentMethod" id="payQR" value="QR" />
                        <label class="form-check-label fw-bold text-success" for="payQR">
                            Chuyển khoản ngân hàng (Quét mã QR ở bước tiếp theo)
                        </label>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG & NÚT ĐẶT HÀNG -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-3">Danh sách sản phẩm (@(Model != null ? Model.Count() : 0) món)</h5>

                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                <div>
                                    <div class="fw-bold text-dark">@item.ProductName</div>
                                    <small class="text-muted">Số lượng: @item.Quantity @item.Unit x @String.Format("{0:0,0}", item.Price) đ</small>
                                </div>
                                <span class="fw-bold text-danger">@String.Format("{0:0,0}", item.TotalPrice) đ</span>
                            </div>
                        }
                    }

                    <div class="d-flex justify-content-between align-items-center my-3 pt-2">
                        <span class="fw-bold fs-5">Tổng thanh toán:</span>
                        <span class="fw-bold fs-4 text-danger">@String.Format("{0:0,0}", totalAmount) đ</span>
                    </div>

                    <button type="button" id="btnSubmitOrder" class="btn btn-success fw-bold w-100 py-2 text-uppercase mb-2">
                        XÁC NHẬN ĐẶT HÀNG
                    </button>
                    <a href="/Cart" class="btn btn-outline-secondary w-100 btn-sm">Quay lại chỉnh sửa giỏ hàng</a>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- POPUP CHỌN ĐỊA CHỈ NHẬN HÀNG & ĐỊNH VỊ GPS -->
<div id="addrModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div class="bg-white rounded-4 shadow-lg p-4 mx-2" style="max-width: 460px; width: 100%;">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
            <h5 class="fw-bold m-0 mx-auto">Địa chỉ nhận hàng</h5>
            <button type="button" id="btnCloseAddr" class="btn-close"></button>
        </div>

        <p class="text-muted small mb-3">
            Thông tin vị trí giúp Bách Hóa Xanh giao hàng đúng giờ và tính phí giao chính xác hơn.
        </p>

        <button type="button" id="btnGetLocationNow" class="btn btn-outline-success fw-bold w-100 rounded-3 py-2 mb-3">
            &#9678; Lấy vị trí hiện tại
        </button>
        <div id="locMsg" class="small text-success mb-2 text-center"></div>

        <div class="mb-2">
            <label class="small text-muted fw-bold">Tỉnh/Thành phố</label>
            <select id="selCity" class="form-select">
                <option value="Thành phố Hồ Chí Minh">Thành phố Hồ Chí Minh</option>
                <option value="Thành phố Hà Nội">Thành phố Hà Nội</option>
                <option value="Thành phố Đà Nẵng">Thành phố Đà Nẵng</option>
                <option value="Tỉnh Bình Dương">Tỉnh Bình Dương</option>
                <option value="Tỉnh Đồng Nai">Tỉnh Đồng Nai</option>
            </select>
        </div>

        <div class="mb-2">
            <label class="small text-muted fw-bold">Phường/Xã</label>
            <select id="selWard" class="form-select">
                <option value="Phường An Nhơn">Phường An Nhơn</option>
                <option value="Phường Hạnh Thông">Phường Hạnh Thông</option>
                <option value="Phường 1, Quận Gò Vấp">Phường 1, Quận Gò Vấp</option>
                <option value="Phường Bến Nghé, Quận 1">Phường Bến Nghé, Quận 1</option>
                <option value="Phường Linh Trung, TP. Thủ Đức">Phường Linh Trung, TP. Thủ Đức</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="small text-muted fw-bold">Số nhà, tên đường <span class="text-danger">*</span></label>
            <input type="text" id="txtStreet" class="form-control" placeholder="Ví dụ: 123 Đường Nguyễn Oanh" />
        </div>

        <button type="button" id="btnApplyAddress" class="btn btn-success fw-bold w-100 py-2">
            XÁC NHẬN ĐỊA CHỈ NÀY
        </button>
    </div>
</div>

<script>
    // 1. XỬ LÝ POPUP CHỌN ĐỊA CHỈ NHẬN HÀNG & ĐỊNH VỊ GPS
    var addrModal = document.getElementById('addrModal');
    var shipInput = document.getElementById('ShippingAddress');
    var selCity = document.getElementById('selCity');
    var selWard = document.getElementById('selWard');
    var txtStreet = document.getElementById('txtStreet');
    var locMsg = document.getElementById('locMsg');

    var btnOpenAddr = document.getElementById('btnOpenAddrModal');
    if (btnOpenAddr) {
        btnOpenAddr.onclick = function () {
            if (addrModal) addrModal.style.display = 'flex';
        };
    }

    var btnCloseAddr = document.getElementById('btnCloseAddr');
    if (btnCloseAddr) {
        btnCloseAddr.onclick = function () {
            if (addrModal) addrModal.style.display = 'none';
        };
    }

    var btnGetLoc = document.getElementById('btnGetLocationNow');
    if (btnGetLoc) {
        btnGetLoc.onclick = function () {
            if (!navigator.geolocation) {
                alert("Trình duyệt không hỗ trợ định vị GPS!");
                return;
            }
            if (locMsg) locMsg.textContent = "Đang lấy vị trí hiện tại của bạn...";
            navigator.geolocation.getCurrentPosition(
                function (pos) {
                    var lat = pos.coords.latitude;
                    var lon = pos.coords.longitude;
                    fetch("https://bigdatacloud.net" + lat + "&longitude=" + lon + "&localityLanguage=vi")
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            if (d) {
                                var detectedWard = d.locality || "Phường Hạnh Thông";
                                var detectedCity = d.principalSubdivision || "Thành phố Hồ Chí Minh";

                                if (selWard) {
                                    var optW = document.createElement('option');
                                    optW.value = detectedWard;
                                    optW.textContent = detectedWard;
                                    optW.selected = true;
                                    selWard.appendChild(optW);
                                }

                                if (selCity) {
                                    var optC = document.createElement('option');
                                    optC.value = detectedCity;
                                    optC.textContent = detectedCity;
                                    optC.selected = true;
                                    selCity.appendChild(optC);
                                }

                                if (locMsg) locMsg.textContent = "Đã định vị xong! Mời bạn nhập thêm số nhà, tên đường bên dưới.";
                                if (txtStreet) txtStreet.focus();
                            }
                        })
                        .catch(function () {
                            if (locMsg) locMsg.textContent = "Đã cập nhật khu vực mặc định! Vui lòng nhập số nhà bên dưới.";
                        });
                },
                function () {
                    if (locMsg) locMsg.textContent = "Không thể lấy GPS, vui lòng chọn thủ công bên dưới.";
                }
            );
        };
    }

    var btnApplyAddr = document.getElementById('btnApplyAddress');
    if (btnApplyAddr) {
        btnApplyAddr.onclick = function () {
            var street = "";
            if (txtStreet && "value" in txtStreet) {
                street = String(txtStreet.value).trim();
            }
            if (!street) {
                alert("Vui lòng nhập Số nhà, tên đường của bạn!");
                if (txtStreet) txtStreet.focus();
                return;
            }
            var ward = (selWard && "value" in selWard) ? String(selWard.value) : "";
            var city = (selCity && "value" in selCity) ? String(selCity.value) : "";
            if (shipInput && "value" in shipInput) {
                shipInput.value = street + ", " + ward + ", " + city;
            }
            if (addrModal) addrModal.style.display = 'none';
        };
    }

    // 2. XỬ LÝ NÚT XÁC NHẬN ĐẶT HÀNG
    var btnSubmitOrder = document.getElementById('btnSubmitOrder');
    var phoneInput = document.getElementById('PhoneInput');

    if (btnSubmitOrder) {
        btnSubmitOrder.onclick = function () {
            var phoneVal = (phoneInput && "value" in phoneInput) ? String(phoneInput.value).trim() : "";
            var phoneRegex = /^0[1-9][0-9]{8}$/;
            if (!phoneRegex.test(phoneVal)) {
                alert("Vui lòng nhập Số điện thoại liên hệ hợp lệ (Bắt đầu bằng 1 số 0 và gồm đúng 10 chữ số)!");
                if (phoneInput) phoneInput.focus();
                return;
            }

            var addrVal = (shipInput && "value" in shipInput) ? String(shipInput.value).trim() : "";
            if (!addrVal) {
                alert("Vui lòng nhập hoặc chọn địa chỉ giao hàng!");
                if (shipInput) shipInput.focus();
                return;
            }

            var form = document.forms.namedItem('checkoutForm');
            if (form) form.submit();
        };
    }
</script>

