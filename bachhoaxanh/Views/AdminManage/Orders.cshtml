@model IEnumerable<bachhoaxanh.Models.Order>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold text-dark m-0">DANH SÁCH ĐƠN ĐẶT HÀNG CỦA KHÁCH</h4>
    <a href="/Admin/Dashboard" class="btn btn-outline-secondary fw-bold">&larr; Quay lại Tổng quan</a>
</div>


<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle text-center">
        <thead class="table-dark">
            <tr>
                <th>Mã đơn</th>
                <th class="text-start">Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">#@item.OrderID</td>
                    <td class="text-start fw-bold">@(item.User != null ? item.User.FullName : "Khách #" + item.UserID)</td>
                    <td>@String.Format("{0:dd/MM/yyyy HH:mm}", item.OrderDate)</td>
                    <td class="text-danger fw-bold">@String.Format("{0:0,0}", item.TotalAmount) đ</td>
                    <td>
                        @if (item.Status == "Khách hủy đơn" || item.Status == "Đã hủy")
                        {
                            <span class="badge bg-danger">@item.Status</span>
                        }
                        else if (item.Status == "Đã giao thành công")
                        {
                            <span class="badge bg-success">@item.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@item.Status</span>
                        }
                    </td>

                    <td>
                        <a href="/AdminManage/OrderDetails/@item.OrderID" class="btn btn-info btn-sm text-white fw-bold">Xem hóa đơn</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
