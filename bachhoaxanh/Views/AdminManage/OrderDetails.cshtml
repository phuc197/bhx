@model bachhoaxanh.Models.Order
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Hóa đơn #" + Model.OrderID;
    var details = ViewBag.OrderDetails as List<bachhoaxanh.Models.OrderDetail>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold text-dark m-0">CHI TIẾT HÓA ĐƠN BÁN HÀNG</h4>
    <a href="/AdminManage/Orders" class="btn btn-outline-secondary">Quay lại danh sách đơn</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<!-- Giao diện Hóa đơn mua hàng thực tế -->
<div class="card shadow-sm border mx-auto" style="max-width: 850px;">
    <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-0 fw-bold text-warning">SIÊU THỊ BÁCH HÓA XANH</h4>
            <small>Phiếu xuất kho & Hóa đơn bán lẻ</small>
        </div>
        <div class="text-end">
            <h5 class="mb-0 fw-bold">HÓA ĐƠN #@Model.OrderID</h5>
            <small>Ngày lập: @String.Format("{0:dd/MM/yyyy HH:mm}", Model.OrderDate)</small>
        </div>
    </div>

    <div class="card-body p-4">
        <div class="row mb-4 border-bottom pb-3">
            <div class="col-sm-6">
                <h6 class="text-muted text-uppercase small fw-bold">Thông tin người mua</h6>
                <p class="mb-1 fw-bold">@(Model.User != null ? Model.User.FullName : "")</p>
                <p class="mb-1 small">Email: @(Model.User != null ? Model.User.Email : "")</p>
                <p class="mb-0 small">SĐT: @(Model.User != null ? Model.User.Phone : "")</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                <h6 class="text-muted text-uppercase small fw-bold">Địa chỉ nhận hàng</h6>
                <p class="mb-2">@Model.ShippingAddress</p>

                <!-- Form cập nhật trạng thái đơn hàng -->
                @if (Model.Status == "Khách hủy đơn")
                {
                    <div class="alert alert-danger py-2 px-3 d-inline-block fw-bold m-0">
                        Trạng thái: Khách hủy đơn (Đã hoàn trả tồn kho)
                    </div>
                }
                else
                {
                    <form action="/AdminManage/UpdateOrderStatus" method="POST" class="d-inline-flex gap-2">
                        <input type="hidden" name="orderId" value="@Model.OrderID" />
                        <select name="status" class="form-select form-select-sm fw-bold">
                            <option value="Chờ xử lý" @(Model.Status == "Chờ xử lý" ? "selected" : "")>Chờ xử lý</option>
                            <option value="Đang giao hàng" @(Model.Status == "Đang giao hàng" ? "selected" : "")>Đang giao hàng</option>
                            <option value="Đã giao thành công" @(Model.Status == "Đã giao thành công" ? "selected" : "")>Đã giao thành công</option>
                            <option value="Đã hủy" @(Model.Status == "Đã hủy" ? "selected" : "")>Admin hủy đơn</option>
                        </select>
                        <button type="submit" class="btn btn-success btn-sm fw-bold">Cập nhật</button>
                    </form>
                }

            </div>
        </div>

        <table class="table table-bordered align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>STT</th>
                    <th class="text-start">Tên mặt hàng</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (details != null)
                {
                    int stt = 1;
                    foreach (var d in details)
                    {
                        <tr>
                            <td>@(stt++)</td>
                            <td class="text-start fw-bold">@(d.Product != null ? d.Product.ProductName : "SP #" + d.ProductID)</td>
                            <td>@String.Format("{0:0,0}", d.Price) đ</td>
                            <td>@d.Quantity</td>
                            <td class="text-end fw-bold">@String.Format("{0:0,0}", d.Price * d.Quantity) đ</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end fw-bold fs-5">TỔNG TIỀN THANH TOÁN:</td>
                    <td class="text-end fw-bold fs-5 text-danger">@String.Format("{0:0,0}", Model.TotalAmount) đ</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
