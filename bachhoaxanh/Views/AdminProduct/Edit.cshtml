@model bachhoaxanh.Models.Product
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Chỉnh sửa sản phẩm";
}

<div class="container-fluid py-3">
    <h4 class="fw-bold text-warning mb-4 border-bottom pb-2">CẬP NHẬT THÔNG TIN SẢN PHẨM</h4>

    <form action="/AdminProduct/Edit" method="POST" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ProductID" value="@Model.ProductID" />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                <input type="text" name="ProductName" value="@Model.ProductName" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Danh mục hàng hóa <span class="text-danger">*</span></label>
                @Html.DropDownList("CategoryID", null, new { @class = "form-select", @required = "required" })
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                <input type="number" name="Price" value="@Convert.ToInt32(Model.Price)" class="form-control" min="1000" required />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Số lượng tồn kho <span class="text-danger">*</span></label>
                <input type="number" name="StockQuantity" value="@Model.StockQuantity" class="form-control" min="0" required />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Đơn vị tính <span class="text-danger">*</span></label>
                <input type="text" name="Unit" value="@Model.Unit" class="form-control" required />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Trạng thái bán</label>
                <select name="IsActive" class="form-select">
                    <option value="true" @(Model.IsActive == true ? "selected" : "")>Đang kinh doanh</option>
                    <option value="false" @(Model.IsActive == false ? "selected" : "")>Ngừng kinh doanh</option>
                </select>
            </div>

            <div class="col-md-8">
                <label class="form-label fw-bold">Thay đổi hình ảnh mới (Bỏ trống nếu giữ ảnh cũ)</label>
                <input type="file" name="ImageFile" class="form-control" accept="image/*" />
            </div>

            <div class="col-md-4 text-center">
                <label class="form-label fw-bold d-block">Ảnh hiện tại</label>
                <img src="~/Images/@Model.ImageURL" class="img-thumbnail" style="max-height: 120px; object-fit: contain;" />
            </div>

            <div class="col-md-12">
                <label class="form-label fw-bold">Mô tả chi tiết</label>
                <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
            </div>

            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-warning fw-bold px-4 py-2">Lưu thay đổi</button>
                <a href="/AdminProduct/Index" class="btn btn-outline-secondary ms-2 py-2">Hủy bỏ</a>
            </div>
        </div>
    </form>
</div>
