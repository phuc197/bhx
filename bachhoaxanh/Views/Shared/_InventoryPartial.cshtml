@model IEnumerable<bachhoaxanh.Models.Product>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle text-center m-0">
        <thead class="table-light">
            <tr>
                <th>Hình ảnh</th>
                <th class="text-start">Tên sản phẩm</th>
                <th>Chủng loại</th>
                <th>Giá bán</th>
                <th>Đã bán</th>
                <th>Tồn kho</th>
                <th>Thao tác nhập kho</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="~/Images/@item.ImageURL" style="width: 50px; height: 50px; object-fit: contain;" />
                        </td>
                        <td class="text-start fw-bold">@item.ProductName</td>
                        <td>@(item.Category != null ? item.Category.CategoryName : "")</td>
                        <td class="text-danger fw-bold">@String.Format("{0:0,0}", item.Price) đ / @item.Unit</td>
                        <td>@item.SoldQuantity @item.Unit</td>
                        <td>
                            @if (item.StockQuantity > 0)
                            {
                                <span class="badge bg-success fs-6">@item.StockQuantity @item.Unit</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">Hết hàng (0)</span>
                            }
                        </td>
                        <td>
                            <!-- Bấm vào nút này sẽ mở trang Sửa để bạn gõ thêm số lượng nhập kho -->
                            <a href="/AdminProduct/Edit/@item.ProductID" class="btn btn-warning btn-sm fw-bold">
                                + Nhập thêm hàng
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-muted py-4">Không có mặt hàng nào trong danh sách này.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
