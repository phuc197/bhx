@model IEnumerable<bachhoaxanh.Models.Product>
@{
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
    ViewBag.Title = ViewBag.CategoryName;
}

<div class="container my-4">
    <!-- Thanh tiêu đề và Bộ lọc tiêu chí -->
    <div class="card shadow-sm border-0 mb-4 p-3 bg-light">
        <div class="row align-items-center">
            <div class="col-md-5">
                <h4 class="fw-bold text-success m-0">
                    <i class="fa-solid fa-list me-2"></i>@ViewBag.CategoryName
                </h4>
                @if (!string.IsNullOrEmpty(ViewBag.Keyword))
                {
                    <small class="text-muted">Kết quả tìm kiếm cho: "<strong>@ViewBag.Keyword</strong>"</small>
                }
            </div>

            <!-- Form lọc theo tiêu chí giá -->
            <div class="col-md-7">
                <form id="filterForm" action="/Product/Category" method="GET" class="row g-2 justify-content-md-end mt-2 mt-md-0">
                    <input type="hidden" name="id" value="@ViewBag.CurrentCategoryId" />
                    <input type="hidden" name="keyword" value="@ViewBag.Keyword" />

                    <div class="col-auto">
                        <!-- Dòng 28: Xóa onchange="this.form.submit()" và thêm id="priceSelect" -->
                        <select id="priceSelect" name="priceFilter" class="form-select form-select-sm">
                            <option value="">-- Lọc theo mức giá --</option>
                            <option value="duoi-50k" @(ViewBag.PriceFilter == "duoi-50k" ? "selected" : "")>Dưới 50.000đ</option>
                            <option value="50k-150k" @(ViewBag.PriceFilter == "50k-150k" ? "selected" : "")>Từ 50.000đ - 150.000đ</option>
                            <option value="tren-150k" @(ViewBag.PriceFilter == "tren-150k" ? "selected" : "")>Trên 150.000đ</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <a href="/Product/Category" class="btn btn-outline-secondary btn-sm">Xóa lọc</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Danh sách sản phẩm -->
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-5">
            <h5>Không tìm thấy sản phẩm bách hóa nào phù hợp!</h5>
            <a href="/" class="btn btn-success mt-2">Quay lại trang chủ</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            @foreach (var item in Model)
            {
                <!-- Ảnh sản phẩm (Đã bọc link xem chi tiết) -->
                <a href="/Product/Detail/@item.ProductID" class="text-decoration-none">
                    <img src="~/Images/@item.ImageURL" class="card-img-top p-3" style="height: 180px; object-fit: contain;" alt="@item.ProductName">
                </a>

                <div class="card-body d-flex flex-column justify-content-between text-center">
                    <div>
                        <!-- Tên sản phẩm (Đã bọc link xem chi tiết) -->
                        <a href="/Product/Detail/@item.ProductID" class="text-decoration-none text-dark">
                            <h6 class="card-title fw-bold text-truncate">@item.ProductName</h6>
                        </a>

                        <p class="text-danger fw-bold fs-5 mb-1">@String.Format("{0:0,0}", item.Price) đ</p>
                        <small class="text-muted d-block mb-3">Tồn kho: <strong class="text-success">@item.StockQuantity</strong> @item.Unit</small>
                    </div>
                    <div class="d-grid gap-2">
                        <a href="/Product/Detail/@item.ProductID" class="btn btn-outline-success btn-sm fw-bold">Xem chi tiết</a>
                        <a href="/Cart/AddToCart?id=@item.ProductID&quantity=1" class="btn btn-success btn-sm fw-bold">CHỌN MUA</a>
                    </div>
                </div>

            }
        </div>

        <!-- Thanh Phân Trang (Pagination) -->
        if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="/Product/Category?id=@ViewBag.CurrentCategoryId&keyword=@ViewBag.Keyword&priceFilter=@ViewBag.PriceFilter&page=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
<script>
        var priceSelect = document.getElementById('priceSelect');
        if (priceSelect) {
            priceSelect.onchange = function () {
                var form = document.forms.namedItem('filterForm');
                if (form) {
                    form.submit();
                }
            };
        }
</script>

