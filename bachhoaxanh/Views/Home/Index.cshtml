@model IEnumerable<bachhoaxanh.Models.Product>
@{
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
    ViewData["Title"] = "Siêu thị Bách Hóa Xanh Online - Mua sắm tươi ngon mỗi ngày";
}

<!-- Banner quảng cáo phong cách Bách Hóa Xanh -->
<div class="p-5 mb-4 bg-light rounded-3 shadow-sm" style="background: linear-gradient(135deg, #008848 0%, #006a37 100%); color: white;">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold text-warning"><i class="fa-solid fa-basket-shopping me-2"></i>Đi Chợ Online</h1>
        <p class="col-md-8 fs-4 text-white-50">Thực phẩm tươi sống, rau củ sạch, giao hàng nhanh chóng tận cửa nhà bạn.</p>
        <a class="btn btn-warning btn-lg text-dark fw-bold" href="/Product/Category">
            <i class="fa-solid fa-bolt me-1"></i>Mua ngay hôm nay
        </a>

    </div>
</div>

<!-- Vùng hiển thị danh sách sản phẩm -->
<div class="container my-5" id="san-pham">
    <h3 class="fw-bold text-success mb-4 border-bottom pb-2">
        <i class="fa-solid fa-fire text-danger me-2"></i>SẢN PHẨM TƯƠI SỐNG ĐANG BÁN
    </h3>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <!-- Nhãn đơn vị tính (kg, bó, chai...) góc ảnh -->
                    <span class="position-absolute top-0 start-0 badge bg-danger m-2 px-2 py-1 small">
                        ĐVT: @item.Unit
                    </span>

                    <!-- Ảnh sản phẩm bách hóa -->
                    <a href="/Product/Detail/@item.ProductID" class="text-decoration-none">
                        <img src="~/Images/@item.ImageURL" class="card-img-top p-3 img-fluid" style="height: 180px; object-fit: contain;" alt="@item.ProductName">
                    </a>

                    <div class="card-body d-flex flex-column justify-content-between text-center">
                        <div>
                            <!-- Tên sản phẩm -->
                            <a href="/Product/Detail/@item.ProductID" class="text-decoration-none text-dark">
                                <h6 class="card-title fw-bold text-truncate" title="@item.ProductName">
                                    @item.ProductName
                                </h6>
                            </a>
                            <!-- Giá bán được format tiền Việt Nam -->
                            <p class="text-danger fw-bold fs-5 mb-1">
                                @String.Format("{0:0,0}", item.Price) đ
                            </p>
                            <!-- Số lượng tồn thực tế phục vụ kiểm tra hiển thị -->
                            <small class="text-muted d-block mb-3">
                                <i class="fa-solid fa-boxes-stacked me-1"></i>Còn lại: <span class="fw-bold text-success">@item.StockQuantity</span> @item.Unit
                            </small>
                        </div>

                        <div class="d-grid gap-2">
                            <!-- Nút Xem chi tiết sản phẩm theo checklist -->
                            <a href="/Product/Detail/@item.ProductID" class="btn btn-outline-success btn-sm fw-bold">
                                <i class="fa-solid fa-eye me-1"></i>Xem chi tiết
                            </a>
                            <!-- Nút MUA sản phẩm chuyển thẳng vào giỏ hàng -->
                            <a href="/Cart/AddToCart?id=@item.ProductID&quantity=1" class="btn btn-success btn-sm fw-bold">
                                <i class="fa-solid fa-cart-plus me-1"></i>CHỌN MUA
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
