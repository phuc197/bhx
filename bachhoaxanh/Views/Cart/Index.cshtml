@model List<bachhoaxanh.Models.CartItem>
@{
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
    ViewBag.Title = "Giỏ hàng của bạn";
}

<div class="container my-5">
    <h3 class="fw-bold text-success mb-4 border-bottom pb-2">
        <i class="fa-solid fa-cart-shopping me-2"></i>GIỎ HÀNG CỦA BẠN
    </h3>

    @if (TempData["CartWarning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["CartWarning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <!-- GIỎ HÀNG RỖNG: Ẩn hoàn toàn nút Thanh toán theo đúng Checklist -->
        <div class="card shadow-sm border-0 p-5 text-center">
            <h5 class="text-muted mb-3">Giỏ hàng của bạn đang trống!</h5>
            <div>
                <a href="/" class="btn btn-success fw-bold px-4">
                    <i class="fa-solid fa-arrow-left me-2"></i>Tiếp tục mua hàng
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- GIỎ HÀNG CÓ SẢN PHẨM -->
        <div class="card shadow-sm border-0 p-4">
            <div class="table-responsive">
                <table class="table align-middle text-center">
                    <thead class="table-success">
                        <tr>
                            <th>Ảnh</th>
                            <th class="text-start">Tên sản phẩm</th>
                            <th>Đơn giá</th>
                            <th style="width: 180px;">Số lượng</th>
                            <th>Thành tiền</th>
                            <th>Xóa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="~/Images/@item.ImageURL" style="width: 60px; height: 60px; object-fit: contain;">
                                </td>
                                <td class="text-start fw-bold">
                                    @item.ProductName
                                    <div class="small text-muted fw-normal">ĐVT: @item.Unit (Kho còn: @item.StockQuantity)</div>
                                </td>
                                <td class="text-danger fw-bold">@String.Format("{0:0,0}", item.Price) đ</td>
                                <td>
                                    <!-- Form cập nhật số lượng tự động khi thay đổi số -->
                                    <form action="/Cart/UpdateQuantity" method="POST" class="d-flex justify-content-center">
                                        <input type="hidden" name="id" value="@item.ProductID" />
                                        <input type="number" name="quantity" value="@item.Quantity"
                                               min="1" max="@item.StockQuantity"
                                               data-max="@item.StockQuantity"
                                               class="form-control form-control-sm text-center fw-bold qty-input"
                                               style="width: 75px;" />

                                    </form>
                                </td>
                                <td class="text-danger fw-bold">@String.Format("{0:0,0}", item.TotalPrice) đ</td>
                                <td>
                                    <a href="/Cart/RemoveFromCart/@item.ProductID" class="btn btn-danger btn-sm fw-bold">
                                        Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row mt-4 align-items-center border-top pt-3">
                <div class="col-md-6 mb-3 mb-md-0">
                    <!-- Link Tiếp tục mua hàng -->
                    <a href="/" class="btn btn-outline-success fw-bold">
                        <i class="fa-solid fa-arrow-left me-2"></i>Tiếp tục mua hàng
                    </a>
                </div>
                <div class="col-md-6 text-md-end">
                    <h4 class="fw-bold mb-3">
                        Tổng tiền: <span class="text-danger">@String.Format("{0:0,0}", ViewBag.TotalAmount) đ</span>
                    </h4>
                    <!-- Link Thanh toán (Chỉ hiện khi giỏ hàng có sản phẩm) -->
                    <a href="/Order/Checkout" class="btn btn-warning btn-lg text-dark fw-bold px-5 shadow-sm">
                        TIẾN HÀNH THANH TOÁN <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
<script>
        var allInputs = document.getElementsByTagName('input');
        for (var i = 0; i < allInputs.length; i++) {
            if (allInputs[i].className.indexOf('qty-input') !== -1) {
                allInputs[i].onchange = function () {
                    var currentInputs = document.getElementsByTagName('input');
                    for (var j = 0; j < currentInputs.length; j++) {
                        var item = currentInputs[j];
                        if (item.className.indexOf('qty-input') !== -1) {
                            var val = parseInt(item.value);
                            var maxStock = parseInt(item.getAttribute('data-max') || '1');

                            if (isNaN(val) || val < 1) {
                                alert("Số lượng mua tối thiểu phải là 1! Nếu không muốn mua nữa, vui lòng bấm nút 'Xóa'.");
                                item.value = "1";
                                if (item.form) item.form.submit();
                                return;
                            }

                            if (val > maxStock) {
                                alert("Số lượng vượt quá tồn kho! Kho chỉ còn tối đa " + maxStock + " sản phẩm.");
                                item.value = maxStock.toString();
                                if (item.form) item.form.submit();
                                return;
                            }

                            if (item.form && document.activeElement === item) {
                                item.form.submit();
                                return;
                            }
                        }
                    }
                };
            }
        }
</script>