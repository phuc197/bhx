@{
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
    ViewBag.Title = "Quên mật khẩu - Bách Hóa Xanh";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 p-4">
                <div class="text-center mb-4">
                    <h4 class="fw-bold text-success">KHÔI PHỤC MẬT KHẨU</h4>
                    <p class="text-muted small">Nhập đúng Email và Số điện thoại đã đăng ký để đặt lại mật khẩu mới</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger small">@ViewBag.Error</div>
                }

                <form action="/Account/ForgotPassword" method="POST">
                    @Html.AntiForgeryToken()

                    <div class="form-floating mb-3">
                        <input type="email" name="email" class="form-control" id="email" placeholder="Email đã đăng ký" required />
                        <label for="email">Địa chỉ Email đã đăng ký <span class="text-danger">*</span></label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="tel" name="phone" class="form-control" id="phone" placeholder="0912345678" pattern="^0[0-9]{9}$" title="Số điện thoại bắt đầu bằng số 0 và đủ 10 số" required />
                        <label for="phone">Số điện thoại xác thực <span class="text-danger">*</span></label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="password" name="newPassword" class="form-control" id="newPassword" placeholder="Mật khẩu mới" minlength="6" pattern="^\S.{4,}\S$" title="Mật khẩu tối thiểu 6 ký tự và không có khoảng trắng đầu/cuối" required />
                        <label for="newPassword">Mật khẩu mới (Ít nhất 6 ký tự) <span class="text-danger">*</span></label>
                    </div>

                    <div class="form-floating mb-4">
                        <input type="password" name="confirmPassword" class="form-control" id="confirmPassword" placeholder="Nhập lại mật khẩu mới" minlength="6" required />
                        <label for="confirmPassword">Xác nhận lại mật khẩu mới <span class="text-danger">*</span></label>
                    </div>

                    <button type="submit" class="btn btn-success fw-bold w-100 py-2 text-uppercase">
                        Đặt lại mật khẩu
                    </button>

                    <hr class="my-4" />
                    <div class="text-center">
                        <a href="/Account/Login" class="small text-decoration-none text-success fw-bold">&larr; Quay lại trang Đăng nhập</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
